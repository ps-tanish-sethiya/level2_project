# DevSentinel Environment Variables Template
# Copy this file to .env and fill in your keys before running.

# Google Gemini API Key (Primary LLM) - Free tier at https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_key_here

# Groq API Key (Fallback LLM) - Free tier at https://console.groq.com/
GROQ_API_KEY=your_groq_key_here

# GitHub Fine-Grained Personal Access Token (Read-only Actions/Repo access)
GITHUB_TOKEN=your_github_token_here

# Target GitHub repository for live build/repo checks (format: owner/repo)
GITHUB_DEMO_REPO=ps-tanish-sethiya/demo-target-repo
